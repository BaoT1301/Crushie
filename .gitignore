# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
.next/
out/
dist/
build/

# Environment
#
# Deny every .env variant and re-admit the examples, rather than listing
# variants individually. The previous list covered .env and the four *.local
# files, which meant a file named .env.production or .env.staging — exactly the
# ones holding live credentials — would have been committed silently.
.env*
!.env.example
!.env*.example

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
.venv/

# Supabase
supabase/.branches
supabase/.temp

# Misc
*.log
.turbo
.orchestrator/

# Orchestrator plumbing (per-run worktrees + MCP cache)
.orchestrator/
.mcp-cache/

# Playwright output
test-results/
playwright-report/
blob-report/
.playwright/
