# ==========================================================================
# Crushie LLM service
#
# Copy to `.env` and fill in. `.env` is gitignored; this template is not, so
# never put real keys in this file.
# ==========================================================================

PORT=3001
NODE_ENV=development


# ── OpenAI (required) ────────────────────────────────────────────────────
# Replaces the previous Gemini + Azure OpenAI pair. There is no free tier;
# billing must be set up before any key works.
OPENAI_API_KEY=

# Main model, used for the analyzer, vibe generation, compatibility and
# identity verification. All one-shot calls.
OPENAI_MODEL=gpt-4o

# Cheap model for the realtime coach, which sends webcam frames continuously.
# This is the single largest avoidable cost on the service: do not point it at
# the main model.
OPENAI_FAST_MODEL=gpt-4o-mini

# Outbound request timeout. Previously there was none, so a hanging upstream
# held the Express request (and the tRPC request above it) open indefinitely.
OPENAI_TIMEOUT_MS=60000

# Embedding model for vibe-profile similarity search.
#
# DO NOT change this on a database that already has embeddings. Vectors are
# only comparable to other vectors from the same model, and the column is
# declared vector(1536) with an index built for that width — a different model
# either fails on insert or, worse, silently returns meaningless similarity
# scores for the mixed rows.
#
# Changing it means: update the column type, rebuild the ivfflat index, and
# re-embed every profile with
#   npm run db:backfill-embeddings --workspace=@starter/web -- --force
OPENAI_EMBEDDING_MODEL=text-embedding-3-small


# ── Service auth (required in production) ────────────────────────────────
# Must match LLM_SERVICE_TOKEN in the web client. The middleware now fails
# CLOSED when this is unset and NODE_ENV is not "development", so a missing
# value here is a 503 rather than a silently open AI proxy.
LLM_SERVICE_TOKEN=


# ── Rate limiting ────────────────────────────────────────────────────────
# These were passed in by docker-compose but read by nothing until now.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000


# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated. Set to your deployed web client origin in production.
CORS_ORIGINS=http://localhost:3000


# ── Redis (optional) ─────────────────────────────────────────────────────
# Caching degrades gracefully if absent. Redis is no longer published to the
# host and now requires a password; set a real one for anything but local dev.
REDIS_PASSWORD=crushie-local-dev
REDIS_URL=redis://:crushie-local-dev@localhost:6379
REDIS_CACHE_TTL=3600


# ── ElevenLabs (optional) ────────────────────────────────────────────────
# Only used by the realtime coach TTS. Free tier is ~10k credits/month,
# requires attribution, and does not permit commercial use.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5


# ── Proxy ────────────────────────────────────────────────────────────────
# Only set this to "true" when a real reverse proxy sits in front and strips
# inbound X-Forwarded-For. Otherwise the rate limiter would trust a
# client-supplied header and any caller could rotate it to get a fresh bucket.
TRUST_PROXY=false
