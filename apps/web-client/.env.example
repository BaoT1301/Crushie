# ============================================================================
# Crushie — web client environment
#
# Copy to `.env` and fill in. It must be named `.env`, not `.env.local`:
# src/db/index.ts and drizzle.config.ts load this exact filename via dotenv.
#
# Anything UNCOMMENTED below is required — the app will not work without it.
# Commented entries are genuinely optional; each degrades gracefully rather
# than crashing, and the comment says what you lose.
# ============================================================================


# ── 1. Clerk (auth) ─────────────────────────────────────────────────────────
#
# Nothing renders without these: ClerkProvider wraps the root layout and
# clerkMiddleware runs on every request.
#
# ALSO REQUIRED, in the Clerk dashboard rather than here: a JWT template named
# exactly `supabase` (Configure -> JWT Templates -> New -> Supabase). Every
# authenticated call runs getToken({ template: "supabase" }) in
# src/db/secure-client.ts. Without it, every authed procedure throws
# UNAUTHORIZED even though the keys below are valid. This is the single most
# common way this app appears broken for no reason.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=


# ── 2. Supabase (database + storage) ────────────────────────────────────────
#
# DATABASE_URL must use the least-privilege `crushie_app` role from migration
# 00009, NOT the default `postgres` role. postgres has BYPASSRLS, which makes
# every RLS policy in this schema inert — the app appears to work while
# enforcing nothing. Verify with `npm run db:preflight`.
#
# Use the Transaction pooler (port 6543), not Direct (5432).
#
#   postgresql://crushie_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Project Settings -> API. NEXT_PUBLIC_SUPABASE_URL does double duty:
# services/llm/client.ts derives its SSRF host allowlist from it, so image
# fetching fails closed if it is missing rather than fetching arbitrary URLs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# ── 3. LLM service ──────────────────────────────────────────────────────────
#
# LLM_SERVICE_TOKEN is a shared secret between this app and the Express AI
# service. That service has no user auth and every endpoint spends money, so
# this token is what separates your server from a stranger's curl. Put the
# IDENTICAL value in apps/llm/.env.
#
# Generate one with: openssl rand -hex 32
#
# LLM_URL defaults to http://localhost:3001, which is correct in development
# and silently wrong in production — it fails with ECONNREFUSED at request
# time, with no build-time signal. Always set it explicitly when deploying.
LLM_URL=http://localhost:3001
LLM_SERVICE_TOKEN=


# ============================================================================
# Everything below is OPTIONAL.
# ============================================================================

# ── Data retention (recommended) ────────────────────────────────────────────
# Secret for /api/cron/retention, which deletes expired uploads and stale rows.
# Without it that endpoint returns 503 and NOTHING is ever deleted — uploaded
# screenshots of third parties accumulate indefinitely. Generate with:
#   openssl rand -hex 32
#
# Vercel Cron sends this automatically (see vercel.json). Elsewhere, point any
# scheduler at:
#   curl -H "Authorization: Bearer $CRON_SECRET" https://<host>/api/cron/retention
# CRON_SECRET=
#
# Retention windows, in days. Uploads go sooner than analyses because the images
# contain third parties who never used this product; the text output is the
# user's own history.
# UPLOAD_RETENTION_DAYS=30
# SESSION_RETENTION_DAYS=180

# ── Deployment ──────────────────────────────────────────────────────────────
# Base URL for server-side tRPC calls. Defaults to http://localhost:3000, so
# leaving it unset in production makes the server call itself on the wrong host.
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# ── Google Maps ─────────────────────────────────────────────────────────────
# Real venues in date suggestions, and the mission map. Needs a billing account
# with a real card even inside the free monthly credit.
#
# Enable: Places API (New), Geocoding API, Maps Static API.
#
# Two separate keys on purpose. The NEXT_PUBLIC one is inlined into the browser
# bundle and is fully extractable, so restrict it by HTTP referrer AND to Static
# Maps only in the Google console. The server key stays unrestricted.
#
# Without these: date suggestions still generate, just without real venues.
# GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── OpenWeather ─────────────────────────────────────────────────────────────
# Weather-aware date planning. Genuinely free, no card. New keys can take a
# couple of hours to activate.
#
# Without it: weather is omitted from planning.
# OPENWEATHER_API_KEY=

# ── Clerk webhook + Resend ──────────────────────────────────────────────────
# Powers only the password-change confirmation email.
#
# Clerk -> Webhooks -> Add Endpoint -> <your-url>/api/webhooks/clerk, subscribe
# to `user.updated`, copy the signing secret here. Without CLERK_WEBHOOK_SECRET
# the endpoint returns 500 on every delivery and Clerk retries indefinitely.
#
# Resend sends from noreply@crushie.app, so you must own and verify that domain.
# CLERK_WEBHOOK_SECRET=
# RESEND_API_KEY=
